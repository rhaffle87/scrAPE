# ------------------------------------------------------------------------------
# scrAPE .gitignore
# ------------------------------------------------------------------------------

# --- Environments and Credentials ---
.env
src/config/*.json

# --- Python Bytecode and Virtual Envs ---
__pycache__/
.pycache/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# --- Test, Linter, and Tool Caches ---
.pytest_cache/
.ruff_cache/
.cache/
*.cache
out/
har/

# --- Build and Package Files ---
*.egg-info/
build/
dist/

# --- Node.js / JS Dependencies ---
node_modules/
crawlee_bridge/node_modules/
/storage/
crawlee_bridge/storage/

# --- Application Outputs & Runtime Data ---
output/*
!output/README.md
data/*
runtime_data/*
logs/
*.log
tasks/*

# --- Datasets and ML ---
datasets/
rag_ingestion/

# --- Seed Configuration ---
seeds/*

# --- Ad-hoc / Temp Files ---
scratch/
*.tmp
*.bak

# --- IDE, Editor, and OS Files ---
.vscode/
.idea/
.qodo/
.DS_Store
Thumbs.db