# ------------------------------------------------------------------------------
# scrAPE Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ------------------------------------------------------------------------------

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Captcha Solvers (Optional, pick one or more) ---
CAPSOLVER_API_KEY=your_capsolver_api_key_here
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here
ANTICAPTCHA_API_KEY=your_anticaptcha_api_key_here

# --- Database / Storage (Optional) ---
# DATABASE_URL=postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
