# scrAPE Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.

# --- Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Mid-run harvest milestone alert threshold (0 = disabled, default = 50)
HARVEST_NOTIFY_THRESHOLD=50

DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
CUSTOM_WEBHOOK_URL=your_custom_webhook_url_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_or_app_token
SMTP_TO=destination_alerts@domain.com
SMTP_USE_TLS=true

# --- Captcha Solvers (Optional, pick one or more) ---
CAPSOLVER_API_KEY=your_capsolver_api_key_here
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here
ANTICAPTCHA_API_KEY=your_anticaptcha_api_key_here

CAPSOLVER_MAX_SPEND_PER_RUN=0.50
CAPSOLVER_MIN_BALANCE=0.20


# --- Scraper & Proxy Configuration ---
PROXY_MAX_BANDWIDTH_MB=500.0
DOWNLOAD_RATE_LIMIT_RPS=5.0
MAX_CONCURRENT_PER_HOST=4
BROWSER_PROFILE_MAX_AGE_DAYS=30
STEALTH_TIER_COOLDOWN_SECONDS=300.0

# --- WebUI Dashboard Settings ---
WEBUI_HOST=0.0.0.0
WEBUI_PORT=10001

# --- AI Dataset Vision Tagging (Optional) ---
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=moondream

# --- Watchdog Monitor Agent Settings ---
SCRAPE_KEYWORD=your_subject_keyword
SCRAPE_SEED_FILE=seeds/your_subject.txt
SCRAPE_SEEDS_DIR=seeds/
SCRAPE_INTERVAL=60
SCRAPE_TIMEOUT=1800

# --- Database / Storage (Optional) ---
# DATABASE_URL=postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
